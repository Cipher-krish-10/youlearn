# =============================================================================
# YouLearn — Environment Variables
# Copy this file to `.env` and fill in the values.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Provider selection ------------------------------------------------------
# Swap any implementation by changing the value — no code changes.
AI_PROVIDER="openai"          # openai | anthropic | gemini | groq
TRANSCRIPT_PROVIDER="supadata" # supadata | whisper | mock
VECTOR_STORE="memory"          # memory | pgvector
DATABASE_PROVIDER="memory"     # memory | prisma
CACHE_PROVIDER="memory"        # memory | upstash

# --- Upstash Redis (cache + rate limiting) ------------------------------------
# Optional. Create a free database at https://console.upstash.com — setting
# these two values activates Redis automatically (memory cache otherwise).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Supabase ----------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Never expose to the client. (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Database (Prisma) -------------------------------------------------------
# Supabase → Settings → Database → Connection string.
# Use the pooled (pgBouncer, port 6543) URL for the app at runtime...
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# ...and the direct (port 5432) URL for migrations.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-region.pooler.supabase.com:5432/postgres"

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Google Gemini (free tier) — used when AI_PROVIDER=gemini ----------------
# Free key: https://aistudio.google.com/app/apikey
# Note: Gemini embeddings are 768-dim, so use VECTOR_STORE=memory (pgvector's
# column is vector(1536) for OpenAI). Videos/artifacts still persist in Postgres.
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# --- Groq (free tier, OpenAI-compatible) — used when AI_PROVIDER=groq --------
# Free key: https://console.groq.com/keys
# Groq has no embeddings endpoint, so chat uses a full-transcript context
# strategy (no RAG/pgvector needed) — keep VECTOR_STORE=memory.
GROQ_API_KEY=""
GROQ_CHAT_MODEL="llama-3.3-70b-versatile"

# --- Transcripts (hosted provider) -------------------------------------------
# Optional. YouTube blocks server-side caption fetches, so live transcripts for
# arbitrary videos require a hosted provider. Get a key at https://supadata.ai
# When unset, ingestion still works (metadata + sample), transcripts show an
# "available soon" state for other videos.
SUPADATA_API_KEY=""
# Override only if your provider's endpoint differs.
SUPADATA_API_URL="https://api.supadata.ai/v1/youtube/transcript"
